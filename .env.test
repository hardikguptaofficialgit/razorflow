# Razorpay (test mode)
RAZORPAY_MCP_ENDPOINT=https://mcp.razorpay.com/mcp
DEFAULT_PAYMENT_CURRENCY=INR
MAX_SPEND_PAISE=500000

# Voice intent fallback
VOICE_INTENT_GROQ_ENABLED=true

# LLM for OSS browser-use Agent
LLM_PROVIDER=groq

# In-app DOM agent planner
PLANNER_STRATEGY=llm
AGENT_RUNTIME_V2=true

# DOM planner - OpenRouter primary, Groq fallback (avoids single-provider cooldown blocking all runs)
PLANNER_LLM_PROVIDER=openrouter
PLANNER_LLM_PROVIDERS=openrouter,groq,gemini
PLANNER_MAX_TOKENS=2048

# Groq / OpenRouter keys: inherit from .env (do not set empty overrides here)

# OpenRouter (fallback)
OPENROUTER_MODEL=google/gemini-2.5-flash-lite:nitro

# Browser-use executor (disabled when V2 runtime handles DOM actions)
BROWSER_USE_EXECUTOR_ENABLED=false
BROWSER_USE_HEADLESS=false
BROWSER_USE_INCLUDE_SCREENSHOT=true
PLANNER_INCLUDE_SCREENSHOT=true
MAX_BROWSER_USE_STEPS=40
# Clear CDP URL to let browser-use auto-launch Chrome
BROWSER_USE_CDP_URL=
