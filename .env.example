# Razorpay (test mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MCP_ENDPOINT=https://mcp.razorpay.com/mcp
DEFAULT_PAYMENT_CURRENCY=INR
MAX_SPEND_PAISE=500000
AGENT_BACKEND_URL=http://127.0.0.1:8765
# Optional shared secret for the storefront → agent-backend payment boundary
AGENT_BACKEND_TOKEN=

# Voice intent fallback (agent-backend Groq classifier for ambiguous transcripts)
VOICE_INTENT_GROQ_ENABLED=true

# LLM for OSS browser-use Agent (BYO only — paid ChatBrowserUse is disabled)
# openrouter | groq | llamacpp
LLM_PROVIDER=openrouter

# In-app DOM agent planner: llm (LLM-first) | hybrid (heuristics before LLM)
PLANNER_STRATEGY=llm
AGENT_RUNTIME_V2=true

# DOM planner — primary openrouter, auto-fallback groq
PLANNER_LLM_PROVIDER=openrouter
PLANNER_LLM_PROVIDERS=openrouter,groq,vercel_ai_gateway,gemini
# Cap planner output tokens (helps OpenRouter when credits are low)
PLANNER_MAX_TOKENS=2048

# OpenRouter (optional cloud BYO) — backup keys tried in order when primary fails
LLM_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite:nitro

# llama.cpp OpenAI-compatible server (scripts/start-llamacpp.ps1)
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMACPP_MODEL=qwen2.5-7b-instruct
LLAMACPP_API_KEY=llamacpp
# LLAMACPP_MODEL_PATH=C:\path\to\Qwen2.5-7B-Instruct-Q4_K_M.gguf

# Groq BYO fallback — backup keys tried in order when primary fails
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b

# Legacy browser-use executor (only when AGENT_RUNTIME_V2=false)
BROWSER_USE_EXECUTOR_ENABLED=false
BROWSER_USE_HEADLESS=false
BROWSER_USE_INCLUDE_SCREENSHOT=true
PLANNER_INCLUDE_SCREENSHOT=true
MAX_BROWSER_USE_STEPS=40
# Attach your Chrome tab for overlay sync:
#   chrome.exe --remote-debugging-port=9222
BROWSER_USE_CDP_URL=http://127.0.0.1:9222

# Legacy observer (off by default)
BROWSER_USE_OBSERVER_ENABLED=false
